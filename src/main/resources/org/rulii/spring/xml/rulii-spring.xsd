<?xml version="1.0" encoding="UTF-8"?>
<schema
        xmlns="http://www.w3.org/2001/XMLSchema"
        xmlns:rulii="http://www.rulii.org/schema/rulii"
        targetNamespace="http://www.rulii.org/schema/rulii"
        elementFormDefault="qualified"
        attributeFormDefault="unqualified">

    <!--
        rulii-spring.xsd — XML namespace schema for defining Rules and RuleSets
        using the rulii framework in a Spring application context.

        Namespace: http://www.rulii.org/schema/rulii
    -->

    <!-- ==================== Scripting Configuration ==================== -->

    <!--
        <rulii:scripting defaultLanguage="el"/>

        Configures the default scripting language used when no language attribute
        is specified on a condition or action element. The directive is scoped to
        the XML file that declares it and applies regardless of its position.
    -->
    <element name="scripting">
        <complexType>
            <attribute name="defaultLanguage" type="string" default="el"/>
        </complexType>
    </element>

    <!-- ==================== Shared Script/Expression Types ==================== -->

    <!--
        Base type for any script-bearing element (condition or action).

        The expression can be provided in two ways:
          1. As the text body of the element:   <given>order.total > 100</given>
          2. As an expr attribute:              <given expr="order.total > 100"/>

        An optional language attribute overrides the default scripting language
        configured via <rulii:scripting>.

        Script text may contain Spring environment placeholders, resolved once at
        startup with @Value semantics: ${key}, ${key:default}, \${...} for a literal.
        Example: <given>order.total >= ${order.minTotal:100}</given>
    -->

    <!-- ==================== Condition Types ==================== -->

    <!--
        A named, optionally described script expression that evaluates to a boolean.
        Used for pre-conditions, main conditions, and stop-conditions.
    -->
    <complexType name="conditionType" mixed="true">
        <attribute name="expr" type="string"/>
        <attribute name="language" type="string"/>
    </complexType>

    <!-- ==================== Action Types ==================== -->

    <!--
        A named, optionally described script expression that performs a side-effect.
        Used for then-actions, otherwise-actions, initializers, and finalizers.
    -->
    <complexType name="actionType" mixed="true">
        <attribute name="expr" type="string"/>
        <attribute name="language" type="string"/>
    </complexType>

    <!-- ==================== Function Types ==================== -->

    <!--
        A named, optionally described script expression that evaluates to a value.
        Used for default value for input params.
    -->
    <complexType name="functionType" mixed="true">
        <attribute name="expr" type="string"/>
        <attribute name="language" type="string"/>
    </complexType>

    <!-- ==================== Parameter Type ==================== -->

    <!--
        Declares a typed input parameter for a RuleSet.

        Attributes:
          name         — parameter name, used for binding resolution
          type         — fully-qualified Java class name (e.g. java.lang.Integer)
          required     — whether the parameter must be bound before execution (default: true)
          description  — optional documentation
    -->
    <complexType name="paramType">
        <sequence>
            <element name="default-value" type="rulii:functionType" minOccurs="0"/>
        </sequence>
        <attribute name="name" type="string" use="required"/>
        <attribute name="type" type="string" use="required"/>
        <attribute name="required" type="boolean" default="true"/>
        <attribute name="description" type="string"/>
    </complexType>

    <!-- ==================== Rule Reference Types ==================== -->

    <!--
        References an existing Spring-managed Rule bean by name.

          <rulii:bean-ref name="myExistingRule"/>
    -->
    <complexType name="beanReferenceType">
        <attribute name="name" type="string" use="required"/>
    </complexType>

    <!--
        Instantiates a Rule class, with optional constructor arguments and
        property injection.

          <rulii:class-ref class="com.example.MinAgeRule">
              <rulii:arg value="18" type="int"/>
              <rulii:property name="errorMessage" value="Too young"/>
          </rulii:class-ref>
    -->
    <complexType name="classReferenceType">
        <sequence>
            <element name="arg" type="rulii:constructorArgType" minOccurs="0" maxOccurs="unbounded"/>
            <element name="property" type="rulii:propertyType" minOccurs="0" maxOccurs="unbounded"/>
        </sequence>
        <attribute name="class" type="string" use="required"/>
    </complexType>

    <!--
        A single constructor argument for a <class-ref>.

        Supply exactly one of:
          value — a literal string value; use type for non-String parameters
          ref   — the name of a Spring bean to inject

        Attributes:
          value — literal value
          ref   — bean name reference (mutually exclusive with value)
          type  — fully-qualified Java type for value conversion (e.g. int, java.math.BigDecimal)
    -->
    <complexType name="constructorArgType">
        <attribute name="value" type="string"/>
        <attribute name="ref" type="string"/>
        <attribute name="type" type="string"/>
    </complexType>

    <!--
        A single property to inject via setter on a <class-ref>.

        Attributes:
          name  — the property name (required)
          value — literal value
          ref   — bean name reference (mutually exclusive with value)
          type  — fully-qualified Java type for value conversion
    -->
    <complexType name="propertyType">
        <attribute name="name" type="string" use="required"/>
        <attribute name="value" type="string"/>
        <attribute name="ref" type="string"/>
        <attribute name="type" type="string"/>
    </complexType>

    <!-- ==================== Rule Element ==================== -->

    <!--
        Defines a complete Rule inline.

        Structure:
          <rulii:rule name="DiscountRule" description="Apply discount for premium orders">
              <pre-condition expr="order != null"/>
              <given>order.customerType == 'PREMIUM'</given>
              <then>order.applyDiscount(0.10)</then>
              <then name="notify">notificationService.send(order)</then>
              <otherwise>order.applyDiscount(0)</otherwise>
          </rulii:rule>

        Attributes:
          name        — unique rule identifier (required)
          description — optional human-readable description

        Child elements (all optional unless noted):
          pre-condition  — guard condition evaluated before the main condition;
                           rule is skipped entirely when this fails
          given          — main condition; rule actions fire only when this is true
          then           — one or more actions executed when the condition is true;
                           multiple <then> elements are executed in declaration order
          otherwise      — action executed when the condition is false
    -->
    <element name="rule">
        <complexType>
            <sequence>
                <element name="pre-condition" type="rulii:conditionType" minOccurs="0"/>
                <element name="given" type="rulii:conditionType" minOccurs="0"/>
                <element name="then" type="rulii:actionType" minOccurs="0" maxOccurs="unbounded"/>
                <element name="otherwise" type="rulii:actionType" minOccurs="0"/>
            </sequence>
            <attribute name="name" type="string" use="required"/>
            <attribute name="description" type="string"/>
            <!-- Terse forms of the condition/action child elements (default scripting
                 language; declaring both the attribute and the child element is a parse
                 error). The then attribute covers the single-action case only. -->
            <attribute name="given" type="string"/>
            <attribute name="pre-condition" type="string"/>
            <attribute name="then" type="string"/>
            <attribute name="otherwise" type="string"/>
        </complexType>
    </element>


    <!-- ==================== Placeholder-aware Numeric Types ==================== -->

    <!--
        Accepts either a plain long/int literal or a Spring property placeholder of
        the form ${key} (non-empty key).  Using xs:union means the schema validator
        tries the numeric member first, then falls back to the placeholder pattern,
        so plain values are still type-checked as proper integers while ${...} tokens
        pass validation and are resolved at runtime by PropertyPlaceholderConfigurer.
    -->
    <simpleType name="longOrPlaceholder">
        <union>
            <simpleType>
                <restriction base="long"/>
            </simpleType>
            <simpleType>
                <restriction base="string">
                    <pattern value="\$\{[^}]+\}"/>
                </restriction>
            </simpleType>
        </union>
    </simpleType>

    <simpleType name="intOrPlaceholder">
        <union>
            <simpleType>
                <restriction base="int"/>
            </simpleType>
            <simpleType>
                <restriction base="string">
                    <pattern value="\$\{[^}]+\}"/>
                </restriction>
            </simpleType>
        </union>
    </simpleType>

    <simpleType name="severityType">
        <restriction base="string">
            <enumeration value="FATAL"/>
            <enumeration value="ERROR"/>
            <enumeration value="WARNING"/>
            <enumeration value="INFO"/>
        </restriction>
    </simpleType>


    <element name="validationRule">
        <complexType>
            <sequence>
                <element name="given" type="rulii:conditionType" minOccurs="0"/>
            </sequence>
            <attribute name="name" type="string" use="required"/>
            <attribute name="description" type="string"/>
            <attribute name="errorCode" type="string" use="required"/>
            <attribute name="severity" type="rulii:severityType" default="ERROR"/>
            <attribute name="errorMessage" type="string"/>
            <attribute name="defaultMessage" type="string"/>
            <!-- Terse form of the <given> child (default scripting language). -->
            <attribute name="given" type="string"/>
        </complexType>
    </element>

    <!-- ==================== Predefined Validation Rules — Base Type ==================== -->

    <!--
        Abstract base type shared by all predefined validation rule elements.

        The value to validate is supplied via exactly one of:
          binding  — name of a binding resolved from the RuleContext at execution time
                     (shorthand for #ctx.bindingName in the default scripting language)
          expr     — script expression returning the value (e.g. expr="#ctx.order.total")
          (body)   — script expression as the element text body

        An optional language attribute overrides the default scripting language
        configured via <rulii:scripting>.

        All override attributes are optional — each rule supplies its own defaults:
          errorCode, severity, errorMessage, description
    -->
    <complexType name="predefinedValidationRuleType" abstract="true" mixed="true">
        <attribute name="name" type="string" use="required"/>
        <attribute name="binding" type="string"/>
        <attribute name="expr" type="string"/>
        <attribute name="language" type="string"/>
        <attribute name="description" type="string"/>
        <attribute name="errorCode" type="string"/>
        <attribute name="severity" type="rulii:severityType"/>
        <attribute name="errorMessage" type="string"/>
    </complexType>


    <!-- ==================== Predefined Validation Rules — No Extra Parameters ==================== -->

    <element name="notNull">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="notBlank">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="notEmpty">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="isNull">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="blank">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="alpha">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="alphaNumeric">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="ascii">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="decimal">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="numeric">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="email">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="url">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="lowerCase">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="upperCase">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="assertFalse">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="assertTrue">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="positive">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="positiveOrZero">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="negative">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="negativeOrZero">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="future">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="futureOrPresent">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="past">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="pastOrPresent">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="fileExists">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>


    <!-- ==================== Predefined Validation Rules — Numeric Bounds ==================== -->

    <element name="min">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <attribute name="min" type="rulii:longOrPlaceholder" use="required"/>
                </extension>
            </complexContent>
        </complexType>
    </element>

    <element name="max">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <attribute name="max" type="rulii:longOrPlaceholder" use="required"/>
                </extension>
            </complexContent>
        </complexType>
    </element>

    <element name="decimalMin">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <attribute name="min" type="string" use="required"/>
                </extension>
            </complexContent>
        </complexType>
    </element>

    <element name="decimalMax">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <attribute name="max" type="string" use="required"/>
                </extension>
            </complexContent>
        </complexType>
    </element>


    <!-- ==================== Predefined Validation Rules — Size / Digits ==================== -->

    <element name="size">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <attribute name="min" type="rulii:intOrPlaceholder" use="required"/>
                    <attribute name="max" type="rulii:intOrPlaceholder" use="required"/>
                </extension>
            </complexContent>
        </complexType>
    </element>

    <element name="digits">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <attribute name="maxIntegerDigits" type="rulii:intOrPlaceholder" use="required"/>
                    <attribute name="maxFractionDigits" type="rulii:intOrPlaceholder" use="required"/>
                </extension>
            </complexContent>
        </complexType>
    </element>


    <!-- ==================== Predefined Validation Rules — Pattern ==================== -->

    <element name="pattern">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <attribute name="pattern" type="string" use="required"/>
                    <attribute name="caseSensitive" type="boolean" default="true"/>
                </extension>
            </complexContent>
        </complexType>
    </element>


    <!-- ==================== Predefined Validation Rules — Equality ==================== -->

    <element name="assertEquals">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <attribute name="value" type="string" use="required"/>
                </extension>
            </complexContent>
        </complexType>
    </element>

    <element name="assertNotEquals">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <attribute name="value" type="string" use="required"/>
                </extension>
            </complexContent>
        </complexType>
    </element>


    <!-- ==================== Predefined Validation Rules — Multi-value ==================== -->

    <!--
        startsWith, endsWith, and in require one or more child string elements.
        minOccurs="1" enforces that at least one entry is present at schema level.
        The value to validate is still supplied via binding or expr on the parent element.
    -->
    <element name="startsWith">
        <complexType mixed="true">
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <sequence>
                        <element name="prefix" type="string" minOccurs="1" maxOccurs="unbounded"/>
                    </sequence>
                </extension>
            </complexContent>
        </complexType>
    </element>

    <element name="endsWith">
        <complexType mixed="true">
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <sequence>
                        <element name="suffix" type="string" minOccurs="1" maxOccurs="unbounded"/>
                    </sequence>
                </extension>
            </complexContent>
        </complexType>
    </element>

    <element name="in">
        <complexType mixed="true">
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <sequence>
                        <element name="item" type="string" minOccurs="1" maxOccurs="unbounded"/>
                    </sequence>
                </extension>
            </complexContent>
        </complexType>
    </element>


    <!-- ==================== RuleSet Element ==================== -->

    <!--
        Defines a RuleSet — an ordered collection of Rules with lifecycle hooks.

        Structure:
          <rulii:ruleset name="OrderProcessingRules" description="Order validation and pricing rules">
              <param name="order"    type="com.example.Order"/>
              <param name="discount" type="java.lang.Double" required="false" defaultValue="0.0"/>

              <pre-condition>order != null</pre-condition>
              <initializer>auditService.begin(order)</initializer>

              <rules>
                  <rulii:rule name="MinimumOrderRule">
                      <given>order.total >= 10</given>
                      <otherwise>throw new ValidationException('Order total too low')</otherwise>
                  </rulii:rule>
                  <bean-ref name="discountRuleBean"/>
                  <class-ref class="com.example.rules.TaxRule"/>
              </rules>

              <stop-condition>order.isInvalid()</stop-condition>
              <finalizer>auditService.end(order)</finalizer>
          </rulii:ruleset>

        Attributes:
          name        — unique ruleset identifier (required)
          description — optional human-readable description

        Child elements (all optional unless noted):
          param          — declares an input parameter; may appear multiple times
          pre-condition  — guard evaluated before any rule is executed;
                           entire ruleset is skipped when this fails
          initializer    — action executed once before rule processing begins
          rules          — ordered container of inline <rule>, <validationRule>, and
                           predefined validator elements, plus <bean-ref> / <class-ref>
                           references to external rules
          stop-condition — condition evaluated between rules; when true, execution halts
                           before the remaining rules are processed
          finalizer      — action executed once after rule processing completes
                           (even when stopped early by the stop-condition)
          result-extractor — function producing the ruleset result after execution
          error-handler    — function invoked when a rule raises an error
    -->
    <element name="ruleset">
        <complexType>
            <sequence>
                <element name="param" type="rulii:paramType" minOccurs="0" maxOccurs="unbounded"/>
                <element name="pre-condition" type="rulii:conditionType" minOccurs="0"/>
                <element name="initializer" type="rulii:actionType" minOccurs="0"/>
                <element name="rules" minOccurs="0">
                    <complexType>
                        <choice minOccurs="0" maxOccurs="unbounded">
                            <element ref="rulii:rule"/>
                            <element ref="rulii:validationRule"/>
                            <element ref="rulii:notNull"/>
                            <element ref="rulii:notBlank"/>
                            <element ref="rulii:notEmpty"/>
                            <element ref="rulii:isNull"/>
                            <element ref="rulii:blank"/>
                            <element ref="rulii:alpha"/>
                            <element ref="rulii:alphaNumeric"/>
                            <element ref="rulii:ascii"/>
                            <element ref="rulii:decimal"/>
                            <element ref="rulii:numeric"/>
                            <element ref="rulii:email"/>
                            <element ref="rulii:url"/>
                            <element ref="rulii:lowerCase"/>
                            <element ref="rulii:upperCase"/>
                            <element ref="rulii:assertFalse"/>
                            <element ref="rulii:assertTrue"/>
                            <element ref="rulii:assertEquals"/>
                            <element ref="rulii:assertNotEquals"/>
                            <element ref="rulii:positive"/>
                            <element ref="rulii:positiveOrZero"/>
                            <element ref="rulii:negative"/>
                            <element ref="rulii:negativeOrZero"/>
                            <element ref="rulii:future"/>
                            <element ref="rulii:futureOrPresent"/>
                            <element ref="rulii:past"/>
                            <element ref="rulii:pastOrPresent"/>
                            <element ref="rulii:fileExists"/>
                            <element ref="rulii:min"/>
                            <element ref="rulii:max"/>
                            <element ref="rulii:decimalMin"/>
                            <element ref="rulii:decimalMax"/>
                            <element ref="rulii:size"/>
                            <element ref="rulii:digits"/>
                            <element ref="rulii:pattern"/>
                            <element ref="rulii:startsWith"/>
                            <element ref="rulii:endsWith"/>
                            <element ref="rulii:in"/>
                            <element name="bean-ref"  type="rulii:beanReferenceType"/>
                            <element name="class-ref" type="rulii:classReferenceType"/>
                        </choice>
                    </complexType>
                </element>
                <element name="stop-condition" type="rulii:conditionType" minOccurs="0"/>
                <element name="finalizer" type="rulii:actionType" minOccurs="0"/>
                <element name="result-extractor" type="rulii:functionType" minOccurs="0"/>
                <element name="error-handler" type="rulii:functionType" minOccurs="0"/>
            </sequence>
            <attribute name="name" type="string" use="required"/>
            <attribute name="description" type="string"/>
            <attribute name="validating" type="boolean" default="false"/>
            <!-- Terse forms of the condition/action child elements (default scripting
                 language; declaring both the attribute and the child element is a parse
                 error). -->
            <attribute name="pre-condition" type="string"/>
            <attribute name="stop-condition" type="string"/>
            <attribute name="initializer" type="string"/>
            <attribute name="finalizer" type="string"/>
        </complexType>
    </element>

    <!-- ==================== RuleFlow Element ==================== -->

    <!--
        Declares a RuleFlow — a pipeline of commands composing Rules, RuleSets, and other
        RuleFlows, mirroring the rulii RuleFlow.builder() DSL. Script expressions substitute
        the builder's lambdas everywhere, using the same conventions as <rule>/<ruleset>
        (expr attribute or element body, optional language attribute, ${property:default}
        placeholders).

          <rulii:ruleflow name="checkoutFlow">
              <param name="order" type="com.example.Order"/>
              <bind name="attempts" value="0"/>
              <run name="ValidateOrderRule" as="valid"/>
              <when>
                  <condition>#ctx.valid == true</condition>
                  <then>
                      <run bean-ref="pricingRuleSet"/>
                  </then>
                  <otherwise>
                      <exit/>
                  </otherwise>
              </when>
              <returning>#ctx.total</returning>
          </rulii:ruleflow>

        Run/async-run targets — exactly one of (parser-enforced):
          bean-ref — a Spring bean (Rule, RuleSet, or RuleFlow), resolved at wiring time
          name     — a RuleRegistry lookup by name, resolved at execution time
          class    — a RuleRegistry lookup by rule class, resolved at execution time

        Java-only DSL features (no XML form): context(Consumer) inline lambdas — use
        <context ref="..."/> with a Consumer<RuleContextBuilder> bean; asyncRun
        withContext(RuleContext) custom contexts.
    -->

    <!-- A step-scoped literal parameter for run/apply commands. -->
    <complexType name="ruleFlowWithParamType">
        <attribute name="name" type="string" use="required"/>
        <attribute name="value" type="string" use="required"/>
    </complexType>

    <!--
        An exception handler. The handler body is a command sequence; the caught exception
        is bound as "ex" for the duration of the body (e.g. #ctx.ex.message).
    -->
    <complexType name="ruleFlowHandlerType">
        <group ref="rulii:ruleFlowCommands" minOccurs="0" maxOccurs="unbounded"/>
        <attribute name="exception" type="string" default="java.lang.Exception"/>
    </complexType>

    <!-- A nested command sequence (when/then, otherwise, scope, then-run bodies). -->
    <complexType name="ruleFlowBodyType">
        <group ref="rulii:ruleFlowCommands" minOccurs="0" maxOccurs="unbounded"/>
    </complexType>

    <simpleType name="asyncContextModeType">
        <restriction base="string">
            <enumeration value="shared"/>
            <enumeration value="immutable"/>
        </restriction>
    </simpleType>

    <simpleType name="timeUnitType">
        <restriction base="string">
            <enumeration value="nanoseconds"/>
            <enumeration value="microseconds"/>
            <enumeration value="milliseconds"/>
            <enumeration value="seconds"/>
            <enumeration value="minutes"/>
            <enumeration value="hours"/>
            <enumeration value="days"/>
        </restriction>
    </simpleType>

    <!-- The recursive command grammar shared by the flow body and every container body. -->
    <group name="ruleFlowCommands">
        <choice>

            <!-- bind: exactly one of value / ref / script expression (parser-enforced). -->
            <element name="bind">
                <complexType mixed="true">
                    <attribute name="name" type="string" use="required"/>
                    <attribute name="scope" type="string"/>
                    <attribute name="value" type="string"/>
                    <attribute name="ref" type="string"/>
                    <attribute name="expr" type="string"/>
                    <attribute name="language" type="string"/>
                </complexType>
            </element>

            <element name="run">
                <complexType>
                    <sequence>
                        <element name="with" type="rulii:ruleFlowWithParamType" minOccurs="0" maxOccurs="unbounded"/>
                        <element name="on-exception" type="rulii:ruleFlowHandlerType" minOccurs="0"/>
                    </sequence>
                    <attribute name="bean-ref" type="string"/>
                    <attribute name="name" type="string"/>
                    <attribute name="class" type="string"/>
                    <attribute name="as" type="string"/>
                    <attribute name="scope" type="string"/>
                </complexType>
            </element>

            <!-- apply: a Function command; the script is the expr attribute or direct text. -->
            <element name="apply">
                <complexType mixed="true">
                    <sequence>
                        <element name="with" type="rulii:ruleFlowWithParamType" minOccurs="0" maxOccurs="unbounded"/>
                        <element name="on-exception" type="rulii:ruleFlowHandlerType" minOccurs="0"/>
                    </sequence>
                    <attribute name="as" type="string"/>
                    <attribute name="scope" type="string"/>
                    <attribute name="expr" type="string"/>
                    <attribute name="language" type="string"/>
                </complexType>
            </element>

            <!-- execute: an Action command; the script is the expr attribute or direct text. -->
            <element name="execute">
                <complexType mixed="true">
                    <sequence>
                        <element name="on-exception" type="rulii:ruleFlowHandlerType" minOccurs="0"/>
                    </sequence>
                    <attribute name="expr" type="string"/>
                    <attribute name="language" type="string"/>
                </complexType>
            </element>

            <element name="async-run">
                <complexType>
                    <sequence>
                        <element name="then-run" minOccurs="0">
                            <complexType>
                                <group ref="rulii:ruleFlowCommands" minOccurs="0" maxOccurs="unbounded"/>
                                <attribute name="result" type="string" use="required"/>
                            </complexType>
                        </element>
                        <element name="on-exception" type="rulii:ruleFlowHandlerType" minOccurs="0"/>
                    </sequence>
                    <attribute name="bean-ref" type="string"/>
                    <attribute name="name" type="string"/>
                    <attribute name="class" type="string"/>
                    <attribute name="as" type="string"/>
                    <attribute name="context-mode" type="rulii:asyncContextModeType" default="shared"/>
                </complexType>
            </element>

            <element name="await">
                <complexType>
                    <attribute name="name" type="string" use="required"/>
                    <attribute name="timeout" type="long"/>
                    <attribute name="unit" type="rulii:timeUnitType" default="seconds"/>
                </complexType>
            </element>

            <element name="await-all">
                <complexType>
                    <attribute name="names" type="string" use="required"/>
                    <attribute name="timeout" type="long"/>
                    <attribute name="unit" type="rulii:timeUnitType" default="seconds"/>
                </complexType>
            </element>

            <element name="await-any">
                <complexType>
                    <attribute name="names" type="string" use="required"/>
                    <attribute name="timeout" type="long"/>
                    <attribute name="unit" type="rulii:timeUnitType" default="seconds"/>
                </complexType>
            </element>

            <element name="when">
                <complexType>
                    <sequence>
                        <element name="condition" type="rulii:conditionType" minOccurs="0"/>
                        <element name="then" type="rulii:ruleFlowBodyType"/>
                        <element name="otherwise" type="rulii:ruleFlowBodyType" minOccurs="0"/>
                    </sequence>
                    <!-- Terse form of the <condition> child (default scripting language;
                         exactly one of the two forms is required). -->
                    <attribute name="condition" type="string"/>
                </complexType>
            </element>

            <element name="for-each">
                <complexType>
                    <sequence>
                        <element name="source" type="rulii:functionType" minOccurs="0"/>
                        <element name="stop-condition" type="rulii:conditionType" minOccurs="0"/>
                        <group ref="rulii:ruleFlowCommands" minOccurs="0" maxOccurs="unbounded"/>
                    </sequence>
                    <attribute name="item" type="string" use="required"/>
                    <!-- Terse forms of the <source>/<stop-condition> children (default
                         scripting language; exactly one source form is required). -->
                    <attribute name="source" type="string"/>
                    <attribute name="stop-condition" type="string"/>
                </complexType>
            </element>

            <element name="scope">
                <complexType>
                    <group ref="rulii:ruleFlowCommands" minOccurs="0" maxOccurs="unbounded"/>
                    <attribute name="name" type="string"/>
                </complexType>
            </element>

            <element name="exit">
                <complexType/>
            </element>

            <!-- Escape hatch: a user-supplied org.rulii.ruleflow.command.RuleFlowCommand bean.
                 With a nested body the bean must be a ContainerCommand (retry, parallel, ...)
                 and receives the body commands; container beans referenced from more than one
                 <command> must be @Scope("prototype") - setBody() mutates the bean. -->
            <element name="command">
                <complexType>
                    <group ref="rulii:ruleFlowCommands" minOccurs="0" maxOccurs="unbounded"/>
                    <attribute name="ref" type="string" use="required"/>
                </complexType>
            </element>

        </choice>
    </group>

    <element name="ruleflow">
        <complexType>
            <sequence>
                <!-- Escape hatch: a Consumer<RuleContextBuilder> bean; must be the first element. -->
                <element name="context" minOccurs="0">
                    <complexType>
                        <attribute name="ref" type="string" use="required"/>
                    </complexType>
                </element>
                <element name="param" type="rulii:paramType" minOccurs="0" maxOccurs="unbounded"/>
                <group ref="rulii:ruleFlowCommands" minOccurs="0" maxOccurs="unbounded"/>
                <element name="on-exception" type="rulii:ruleFlowHandlerType" minOccurs="0"/>
                <element name="finalizer" type="rulii:actionType" minOccurs="0"/>
                <element name="returning" type="rulii:functionType" minOccurs="0"/>
            </sequence>
            <attribute name="name" type="string" use="required"/>
            <attribute name="description" type="string"/>
            <!-- Terse forms of the finalizer/returning child elements (default scripting
                 language; declaring both the attribute and the child element is a parse
                 error). -->
            <attribute name="finalizer" type="string"/>
            <attribute name="returning" type="string"/>
        </complexType>
    </element>

</schema>
