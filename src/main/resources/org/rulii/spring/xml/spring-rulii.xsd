<?xml version="1.0" encoding="UTF-8"?>
<schema
        xmlns="http://www.w3.org/2001/XMLSchema"
        xmlns:rulii="http://www.rulii.org/schema/rulii"
        targetNamespace="http://www.rulii.org/schema/rulii"
        elementFormDefault="qualified"
        attributeFormDefault="unqualified">

    <!--
        spring-rulii.xsd — XML namespace schema for defining Rules and RuleSets
        using the rulii framework in a Spring application context.

        Namespace: http://www.rulii.org/schema/rulii
    -->

    <!-- ==================== Scripting Configuration ==================== -->

    <!--
        <rulii:scripting defaultLanguage="spel"/>

        Configures the default scripting language used when no language attribute
        is specified on a condition or action element.
    -->
    <element name="scripting">
        <complexType>
            <attribute name="defaultLanguage" type="string" default="el"/>
        </complexType>
    </element>

    <!-- ==================== Shared Script/Expression Types ==================== -->

    <!--
        Base type for any script-bearing element (condition or action).

        The expression can be provided in two ways:
          1. As the text body of the element:   <given>order.total > 100</given>
          2. As a script attribute:             <given script="order.total > 100"/>

        An optional language attribute overrides the default scripting language
        configured via <rulii:scripting>.
    -->

    <!-- ==================== Condition Types ==================== -->

    <!--
        A named, optionally described script expression that evaluates to a boolean.
        Used for pre-conditions, main conditions, and stop-conditions.
    -->
    <complexType name="conditionType" mixed="true">
        <attribute name="expr" type="string"/>
        <attribute name="language" type="string"/>
    </complexType>

    <!-- ==================== Action Types ==================== -->

    <!--
        A named, optionally described script expression that performs a side-effect.
        Used for then-actions, otherwise-actions, initializers, and finalizers.
    -->
    <complexType name="actionType" mixed="true">
        <attribute name="expr" type="string"/>
        <attribute name="language" type="string"/>
    </complexType>

    <!-- ==================== Function Types ==================== -->

    <!--
        A named, optionally described script expression that evaluates to a value.
        Used for default value for input params.
    -->
    <complexType name="functionType" mixed="true">
        <attribute name="expr" type="string"/>
        <attribute name="language" type="string"/>
    </complexType>

    <!-- ==================== Parameter Type ==================== -->

    <!--
        Declares a typed input parameter for a RuleSet.

        Attributes:
          name         — parameter name, used for binding resolution
          type         — fully-qualified Java class name (e.g. java.lang.Integer)
          required     — whether the parameter must be bound before execution (default: true)
          description  — optional documentation
    -->
    <complexType name="paramType">
        <sequence>
            <element name="default-value" type="rulii:functionType" minOccurs="0"/>
        </sequence>
        <attribute name="name" type="string" use="required"/>
        <attribute name="type" type="string" use="required"/>
        <attribute name="required" type="boolean" default="true"/>
        <attribute name="description" type="string"/>
    </complexType>

    <!-- ==================== Rule Reference Type ==================== -->

    <!--
        A reference to an existing Rule defined elsewhere — either by Spring bean
        name or by fully-qualified class name.
    -->
    <complexType name="ruleReferenceType">
        <attribute name="beanName" type="string"/>
        <attribute name="className" type="string"/>
    </complexType>

    <!-- ==================== Rule Element ==================== -->

    <!--
        Defines a complete Rule inline.

        Structure:
          <rulii:rule name="DiscountRule" description="Apply discount for premium orders">
              <pre-condition script="order != null"/>
              <given>order.customerType == 'PREMIUM'</given>
              <then>order.applyDiscount(0.10)</then>
              <then name="notify">notificationService.send(order)</then>
              <otherwise>order.applyDiscount(0)</otherwise>
          </rulii:rule>

        Attributes:
          name        — unique rule identifier (required)
          description — optional human-readable description

        Child elements (all optional unless noted):
          pre-condition  — guard condition evaluated before the main condition;
                           rule is skipped entirely when this fails
          given          — main condition; rule actions fire only when this is true
          then           — one or more actions executed when the condition is true;
                           multiple <then> elements are executed in declaration order
          otherwise      — action executed when the condition is false
    -->
    <element name="rule">
        <complexType>
            <sequence>
                <element name="pre-condition" type="rulii:conditionType" minOccurs="0"/>
                <element name="given" type="rulii:conditionType" minOccurs="0"/>
                <element name="then" type="rulii:actionType" minOccurs="0" maxOccurs="unbounded"/>
                <element name="otherwise" type="rulii:actionType" minOccurs="0"/>
            </sequence>
            <attribute name="name" type="string" use="required"/>
            <attribute name="description" type="string"/>
        </complexType>
    </element>


    <simpleType name="severityType">
        <restriction base="string">
            <enumeration value="FATAL"/>
            <enumeration value="ERROR"/>
            <enumeration value="WARNING"/>
            <enumeration value="INFO"/>
        </restriction>
    </simpleType>


    <element name="validationRule">
        <complexType>
            <sequence>
                <element name="given" type="rulii:conditionType" minOccurs="0"/>
            </sequence>
            <attribute name="name" type="string" use="required"/>
            <attribute name="description" type="string"/>
            <attribute name="errorCode" type="string" use="required"/>
            <attribute name="severity" type="rulii:severityType" default="ERROR"/>
            <attribute name="errorMessage" type="string"/>
            <attribute name="defaultMessage" type="string"/>
        </complexType>
    </element>

    <!-- ==================== Predefined Validation Rules — Base Type ==================== -->

    <!--
        Abstract base type shared by all predefined validation rule elements.

        The value to validate is supplied via exactly one of:
          binding  — name of a binding resolved from the RuleContext at execution time
                     (shorthand for #ctx.bindingName in the default scripting language)
          expr     — script expression returning the value (e.g. expr="#ctx.order.total")
          (body)   — script expression as the element text body

        An optional language attribute overrides the default scripting language
        configured via <rulii:scripting>.

        All override attributes are optional — each rule supplies its own defaults:
          errorCode, severity, errorMessage, description
    -->
    <complexType name="predefinedValidationRuleType" abstract="true">
        <attribute name="name" type="string" use="required"/>
        <attribute name="binding" type="string"/>
        <attribute name="expr" type="string"/>
        <attribute name="language" type="string"/>
        <attribute name="description" type="string"/>
        <attribute name="errorCode" type="string"/>
        <attribute name="severity" type="rulii:severityType"/>
        <attribute name="errorMessage" type="string"/>
    </complexType>


    <!-- ==================== Predefined Validation Rules — No Extra Parameters ==================== -->

    <element name="notNull">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="notBlank">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="notEmpty">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="isNull">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="blank">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="alpha">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="alphaNumeric">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="ascii">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="decimal">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="numeric">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="email">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="url">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="lowerCase">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="upperCase">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="assertFalse">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="assertTrue">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="positive">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="positiveOrZero">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="negative">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="negativeOrZero">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="future">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="futureOrPresent">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="past">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="pastOrPresent">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>

    <element name="fileExists">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType"/>
            </complexContent>
        </complexType>
    </element>


    <!-- ==================== Predefined Validation Rules — Numeric Bounds ==================== -->

    <element name="min">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <attribute name="min" type="long" use="required"/>
                </extension>
            </complexContent>
        </complexType>
    </element>

    <element name="max">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <attribute name="max" type="long" use="required"/>
                </extension>
            </complexContent>
        </complexType>
    </element>

    <element name="decimalMin">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <attribute name="min" type="string" use="required"/>
                </extension>
            </complexContent>
        </complexType>
    </element>

    <element name="decimalMax">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <attribute name="max" type="string" use="required"/>
                </extension>
            </complexContent>
        </complexType>
    </element>


    <!-- ==================== Predefined Validation Rules — Size / Digits ==================== -->

    <element name="size">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <attribute name="min" type="int" use="required"/>
                    <attribute name="max" type="int" use="required"/>
                </extension>
            </complexContent>
        </complexType>
    </element>

    <element name="digits">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <attribute name="maxIntegerDigits" type="int" use="required"/>
                    <attribute name="maxFractionDigits" type="int" use="required"/>
                </extension>
            </complexContent>
        </complexType>
    </element>


    <!-- ==================== Predefined Validation Rules — Pattern ==================== -->

    <element name="pattern">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <attribute name="pattern" type="string" use="required"/>
                    <attribute name="caseSensitive" type="boolean" default="true"/>
                </extension>
            </complexContent>
        </complexType>
    </element>


    <!-- ==================== Predefined Validation Rules — Equality ==================== -->

    <element name="assertEquals">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <attribute name="value" type="string" use="required"/>
                </extension>
            </complexContent>
        </complexType>
    </element>

    <element name="assertNotEquals">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <attribute name="value" type="string" use="required"/>
                </extension>
            </complexContent>
        </complexType>
    </element>


    <!-- ==================== Predefined Validation Rules — Multi-value ==================== -->

    <!--
        startsWith, endsWith, and in require one or more child string elements.
        minOccurs="1" enforces that at least one entry is present at schema level.
        The value to validate is still supplied via binding or expr on the parent element.
    -->
    <element name="startsWith">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <sequence>
                        <element name="prefix" type="string" minOccurs="1" maxOccurs="unbounded"/>
                    </sequence>
                </extension>
            </complexContent>
        </complexType>
    </element>

    <element name="endsWith">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <sequence>
                        <element name="suffix" type="string" minOccurs="1" maxOccurs="unbounded"/>
                    </sequence>
                </extension>
            </complexContent>
        </complexType>
    </element>

    <element name="in">
        <complexType>
            <complexContent>
                <extension base="rulii:predefinedValidationRuleType">
                    <sequence>
                        <element name="item" type="string" minOccurs="1" maxOccurs="unbounded"/>
                    </sequence>
                </extension>
            </complexContent>
        </complexType>
    </element>


    <!-- ==================== RuleSet Element ==================== -->

    <!--
        Defines a RuleSet — an ordered collection of Rules with lifecycle hooks.

        Structure:
          <rulii:ruleset name="OrderProcessingRules" description="Order validation and pricing rules">
              <param name="order"    type="com.example.Order"/>
              <param name="discount" type="java.lang.Double" required="false" defaultValue="0.0"/>

              <pre-condition>order != null</pre-condition>
              <initializer>auditService.begin(order)</initializer>

              <rules>
                  <rulii:rule name="MinimumOrderRule">
                      <given>order.total >= 10</given>
                      <otherwise>throw new ValidationException('Order total too low')</otherwise>
                  </rulii:rule>
                  <rule-ref beanName="discountRuleBean"/>
                  <rule-ref className="com.example.rules.TaxRule"/>
              </rules>

              <stop-condition>order.isInvalid()</stop-condition>
              <finalizer>auditService.end(order)</finalizer>
          </rulii:ruleset>

        Attributes:
          name        — unique ruleset identifier (required)
          description — optional human-readable description

        Child elements (all optional unless noted):
          param          — declares an input parameter; may appear multiple times
          pre-condition  — guard evaluated before any rule is executed;
                           entire ruleset is skipped when this fails
          initializer    — action executed once before rule processing begins
          rules          — ordered container of inline <rule> elements and
                           <rule-ref> references to external rules
          stop-condition — condition evaluated between rules; when true, execution halts
                           before the remaining rules are processed
          finalizer      — action executed once after rule processing completes
                           (even when stopped early by the stop-condition)
    -->
    <element name="ruleset">
        <complexType>
            <sequence>
                <element name="param" type="rulii:paramType" minOccurs="0" maxOccurs="unbounded"/>
                <element name="pre-condition" type="rulii:conditionType" minOccurs="0"/>
                <element name="initializer" type="rulii:actionType" minOccurs="0"/>
                <element name="rules" minOccurs="0">
                    <complexType>
                        <choice minOccurs="0" maxOccurs="unbounded">
                            <element ref="rulii:rule"/>
                            <element ref="rulii:validationRule"/>
                            <element ref="rulii:notNull"/>
                            <element ref="rulii:notBlank"/>
                            <element ref="rulii:notEmpty"/>
                            <element ref="rulii:isNull"/>
                            <element ref="rulii:blank"/>
                            <element ref="rulii:alpha"/>
                            <element ref="rulii:alphaNumeric"/>
                            <element ref="rulii:ascii"/>
                            <element ref="rulii:decimal"/>
                            <element ref="rulii:numeric"/>
                            <element ref="rulii:email"/>
                            <element ref="rulii:url"/>
                            <element ref="rulii:lowerCase"/>
                            <element ref="rulii:upperCase"/>
                            <element ref="rulii:assertFalse"/>
                            <element ref="rulii:assertTrue"/>
                            <element ref="rulii:assertEquals"/>
                            <element ref="rulii:assertNotEquals"/>
                            <element ref="rulii:positive"/>
                            <element ref="rulii:positiveOrZero"/>
                            <element ref="rulii:negative"/>
                            <element ref="rulii:negativeOrZero"/>
                            <element ref="rulii:future"/>
                            <element ref="rulii:futureOrPresent"/>
                            <element ref="rulii:past"/>
                            <element ref="rulii:pastOrPresent"/>
                            <element ref="rulii:fileExists"/>
                            <element ref="rulii:min"/>
                            <element ref="rulii:max"/>
                            <element ref="rulii:decimalMin"/>
                            <element ref="rulii:decimalMax"/>
                            <element ref="rulii:size"/>
                            <element ref="rulii:digits"/>
                            <element ref="rulii:pattern"/>
                            <element ref="rulii:startsWith"/>
                            <element ref="rulii:endsWith"/>
                            <element ref="rulii:in"/>
                            <element name="rule-ref" type="rulii:ruleReferenceType"/>
                        </choice>
                    </complexType>
                </element>
                <element name="stop-condition" type="rulii:conditionType" minOccurs="0"/>
                <element name="finalizer" type="rulii:actionType" minOccurs="0"/>
                <element name="result-extractor" type="rulii:functionType" minOccurs="0"/>
                <element name="error-handler" type="rulii:functionType" minOccurs="0"/>
            </sequence>
            <attribute name="name" type="string" use="required"/>
            <attribute name="description" type="string"/>
            <attribute name="validating" type="boolean" default="false"/>
        </complexType>
    </element>

</schema>
